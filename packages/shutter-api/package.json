{
  "name": "@anywalletkit/shutter-api",
  "version": "0.0.0",
  "description": "Shutter API for wallets and apps: seal a message until a time (commit-reveal) with Shutter's threshold encryption. Encryption and decryption run on the device in pure TypeScript (BLS12-381 IBE, byte-compatible with Shutter's own SDK), decryption keys are verified by pairing before use, identities register through the API or straight from the user's own account on Gnosis. Works in React Native (Hermes), browsers and Node.",
  "license": "Apache-2.0",
  "homepage": "https://docs.anywallet.tech",
  "bugs": { "url": "https://github.com/ultratestbro/anywalletkit/issues" },
  "repository": { "type": "git", "url": "git+https://github.com/ultratestbro/anywalletkit.git", "directory": "packages/shutter-api" },
  "type": "module",
  "engines": { "node": ">=22" },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "vitest": "^5.1.0"
  },
  "keywords": ["shutter", "threshold-encryption", "commit-reveal", "timelock", "ibe", "bls12-381", "gnosis", "anywalletkit"],
  "publishConfig": { "access": "public", "provenance": true }
}
