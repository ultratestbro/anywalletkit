{
  "name": "@anywalletkit/protocol-swap2-cctp",
  "version": "0.1.3",
  "description": "Circle CCTP V2 for the swap2 engine: native USDC between EVM chains by burn-and-mint (Fast Transfer or Standard), attestation via Circle's Iris API, two-phase delivery with the user's own receiveMessage claim. Bound to Circle's documented contracts and native USDC per domain.",
  "license": "Apache-2.0",
  "homepage": "https://docs.anywallet.tech",
  "bugs": { "url": "https://github.com/ultratestbro/anywalletkit/issues" },
  "repository": { "type": "git", "url": "git+https://github.com/ultratestbro/anywalletkit.git", "directory": "packages/protocol-swap2-cctp" },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" },
    "./config": { "types": "./dist/config.d.ts", "import": "./dist/config.js", "require": "./dist/config.cjs" },
    "./provider": { "types": "./dist/provider.d.ts", "import": "./dist/provider.js", "require": "./dist/provider.cjs" },
    "./protocol": { "types": "./dist/protocol.d.ts", "import": "./dist/protocol.js", "require": "./dist/protocol.cjs" },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "module.json"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "echo ok",
    "verify:live": "node scripts/verify-live.mjs"
  },
  "dependencies": {
    "@anywalletkit/protocol-swap2-core": "workspace:*",
    "@anywalletkit/swap2-assets": "workspace:*",
    "viem": "^2.57.2"
  },
  "peerDependencies": { "@anywalletkit/core": "workspace:*" },
  "devDependencies": {
    "@types/node": "^22",
    "vitest": "^5.0.3",
    "@anywalletkit/conformance": "workspace:*",
    "@anywalletkit/core": "workspace:*"
  },
  "keywords": ["swap2", "bridge", "cctp", "circle", "usdc", "burn-and-mint", "anywalletkit"],
  "publishConfig": { "access": "public", "provenance": true }
}
