{
  "name": "@anywalletkit/extension-kit",
  "version": "0.2.0",
  "description": "Chromium (MV3) wallet-extension core for Any Wallet Kit: scrypt + AES-256-GCM vault with passkey (WebAuthn PRF) unlock, auto-locking session, dApp request router with per-origin permissions and an approval queue, signing-request checks, swap / Earn plan review, chrome.* adapters. No UI.",
  "license": "Apache-2.0",
  "homepage": "https://docs.anywallet.tech",
  "bugs": { "url": "https://github.com/ultratestbro/anywalletkit/issues" },
  "repository": { "type": "git", "url": "git+https://github.com/ultratestbro/anywalletkit.git", "directory": "packages/extension-kit" },
  "type": "module",
  "engines": { "node": ">=22" },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "keywords": [
    "wallet",
    "sdk",
    "browser-extension",
    "mv3",
    "chrome-extension",
    "vault",
    "eip-1193"
  ],
  "dependencies": {
    "@anywalletkit/core": "workspace:*",
    "@anywalletkit/keyring": "workspace:*",
    "@anywalletkit/swap2-assets": "workspace:*",
    "@anywalletkit/protocol-swap2-core": "workspace:*",
    "@anywalletkit/wallet-evm": "workspace:*",
    "@noble/hashes": "^2.4.0"
  },
  "devDependencies": {
    "@anywalletkit/wallet-ton": "workspace:*",
    "vitest": "^5.0.3",
    "viem": "^2.57.2"
  },
  "publishConfig": { "access": "public", "provenance": true }
}
