{
  "name": "@anywalletkit/keyring",
  "version": "0.2.0",
  "description": "Multi-account, multi-source keyring for Any Wallet Kit: many accounts from one seed, imported seeds and private keys, account discovery — secrets stay in the app's secure storage.",
  "license": "Apache-2.0",
  "homepage": "https://docs.anywallet.tech",
  "bugs": { "url": "https://github.com/ultratestbro/anywalletkit/issues" },
  "repository": { "type": "git", "url": "git+https://github.com/ultratestbro/anywalletkit.git", "directory": "packages/keyring" },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "echo ok"
  },
  "keywords": [
    "wallet",
    "sdk",
    "keyring",
    "multi-account",
    "import"
  ],
  "dependencies": {
    "@anywalletkit/core": "workspace:*",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@scure/base": "^2.4.0",
    "@scure/bip32": "^2.4.0"
  },
  "devDependencies": {
    "@anywalletkit/wallet-btc": "workspace:*",
    "@anywalletkit/wallet-evm": "workspace:*",
    "@anywalletkit/wallet-near": "workspace:*",
    "@anywalletkit/wallet-solana": "workspace:*",
    "@anywalletkit/wallet-ton": "workspace:*",
    "@anywalletkit/wallet-tron": "workspace:*",
    "@anywalletkit/wallet-zcash": "workspace:*",
    "viem": "^2.57.2",
    "@ton/crypto": "^3.3.0",
    "vitest": "^5.0.3"
  },
  "publishConfig": { "access": "public", "provenance": true }
}
