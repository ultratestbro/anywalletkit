{
  "name": "@forgewallet/protocol-swap2-chainflip",
  "version": "0.1.0",
  "description": "Chainflip vault swaps for the swap2 engine: native BTC / ETH / SOL / TRX and USDC / USDT across Ethereum, Arbitrum, Solana, Tron and Bitcoin through Chainflip's public backend (its own broker, 0 bps, no account). Sources in this release: Ethereum, Arbitrum and Tron (a plain USDT transfer to the Vault with the swap in the note — no approval, no 3.4 USDT channel fee). Every byte the encoder returns is decoded and checked before signing; fill-or-kill refunds to the sender.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" },
    "./config": { "types": "./dist/config.d.ts", "import": "./dist/config.js", "require": "./dist/config.cjs" },
    "./codec": { "types": "./dist/codec.d.ts", "import": "./dist/codec.js", "require": "./dist/codec.cjs" },
    "./provider": { "types": "./dist/provider.d.ts", "import": "./dist/provider.js", "require": "./dist/provider.cjs" },
    "./protocol": { "types": "./dist/protocol.d.ts", "import": "./dist/protocol.js", "require": "./dist/protocol.cjs" },
    "./activity": { "types": "./dist/activity.d.ts", "import": "./dist/activity.js", "require": "./dist/activity.cjs" },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "module.json"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "echo ok"
  },
  "dependencies": {
    "@forgewallet/protocol-swap2-core": "workspace:*",
    "@noble/hashes": "^2.4.0",
    "@scure/base": "^2.4.0",
    "viem": "^2.57.2"
  },
  "peerDependencies": { "@forgewallet/core": "workspace:*" },
  "devDependencies": {
    "@types/node": "^22",
    "vitest": "^5.0.3",
    "@forgewallet/conformance": "workspace:*",
    "@forgewallet/protocol-swap2-router": "workspace:*",
    "@forgewallet/core": "workspace:*"
  },
  "keywords": ["swap2", "bridge", "chainflip", "tron", "bitcoin", "solana", "forgewallet"]
}
