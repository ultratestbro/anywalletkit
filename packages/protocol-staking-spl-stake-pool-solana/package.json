{
  "name": "@anywalletkit/protocol-staking-spl-stake-pool-solana",
  "version": "0.2.2",
  "description": "A simple package that lets @anywalletkit/wallet-solana wallet accounts stake through SPL stake pools (Jito by default): stake SOL \u2192 JitoSOL, exit instantly from the reserve or through a stake account, claim, read rates, APY and earnings.",
  "license": "Apache-2.0",
  "homepage": "https://docs.anywallet.tech",
  "bugs": { "url": "https://github.com/ultratestbro/anywalletkit/issues" },
  "repository": { "type": "git", "url": "git+https://github.com/ultratestbro/anywalletkit.git", "directory": "packages/protocol-staking-spl-stake-pool-solana" },
  "type": "module",
  "main": "index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./index.js"
    },
    "./package": {
      "default": "./package.json"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "src",
    "types",
    "module.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "echo \"plain ESM, nothing to build\"",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.js && vitest run",
    "lint": "echo ok",
    "verify:live": "node scripts/verify-live.mjs"
  },
  "dependencies": {
    "@solana/addresses": "^3.0.3",
    "@solana/instructions": "^3.0.3"
  },
  "peerDependencies": {
    "@anywalletkit/core": "workspace:*"
  },
  "devDependencies": {
    "@solana/transaction-messages": "^3.0.3",
    "@solana/transactions": "^3.0.3",
    "@anywalletkit/core": "workspace:*",
    "@anywalletkit/conformance": "workspace:*",
    "vitest": "^5.0.3"
  },
  "keywords": [
    "protocol",
    "staking",
    "solana",
    "jito",
    "jitosol",
    "spl-stake-pool",
    "liquid-staking",
    "staking-protocol",
    "anywalletkit",
    "staking"
  ],
  "publishConfig": { "access": "public", "provenance": true }
}
