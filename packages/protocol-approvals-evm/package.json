{
  "name": "@forgewallet/protocol-approvals-evm",
  "version": "0.3.0",
  "description": "A simple package that lets @forgewallet/wallet-evm wallet accounts discover the token approvals they have granted (ERC-20 allowances, ERC-721 / ERC-1155 operators and per-token approvals, Permit2 allowances, EIP-7702 delegations), flag the risky ones, and revoke them one by one or all at once.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "module.json",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "echo ok",
    "verify:live": "node scripts/verify-live.mjs"
  },
  "dependencies": {
    "viem": "^2.57.2"
  },
  "peerDependencies": {
    "@forgewallet/core": "workspace:*"
  },
  "devDependencies": {
    "@forgewallet/conformance": "workspace:*",
    "@forgewallet/core": "workspace:*",
    "@types/node": "^22",
    "vitest": "^5.0.3"
  },
  "keywords": [
    "protocol",
    "approvals",
    "allowance",
    "revoke",
    "permit2",
    "erc20",
    "erc721",
    "erc1155",
    "eip7702",
    "security",
    "ethereum",
    "forgewallet",
    "approvals"
  ]
}
