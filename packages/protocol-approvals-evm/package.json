{
  "name": "@forgewallet/protocol-approvals-evm",
  "version": "0.1.0",
  "description": "A simple package that lets @forgewallet/wallet-evm wallet accounts discover the token approvals they have granted (ERC-20 allowances, ERC-721 / ERC-1155 operators and per-token approvals, Permit2 allowances, EIP-7702 delegations), flag the risky ones, and revoke them one by one or all at once.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./index.js"
    },
    "./policies": {
      "default": "./src/policies.js"
    },
    "./package": {
      "default": "./package.json"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "src",
    "types",
    "module.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "echo \"plain ESM, nothing to build\"",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.js && vitest run",
    "lint": "echo ok",
    "verify:live": "node scripts/verify-live.mjs"
  },
  "dependencies": {
    "ethers": "^6.17.0"
  },
  "peerDependencies": {
    "@forgewallet/core": "workspace:*"
  },
  "devDependencies": {
    "@forgewallet/core": "workspace:*",
    "@forgewallet/conformance": "workspace:*",
    "vitest": "^5.0.3"
  },
  "keywords": [
    "protocol",
    "approvals",
    "allowance",
    "revoke",
    "permit2",
    "erc20",
    "erc721",
    "erc1155",
    "eip7702",
    "security",
    "ethereum",
    "forgewallet",
    "approvals"
  ]
}
