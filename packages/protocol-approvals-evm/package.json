{
  "name": "@anywalletkit/protocol-approvals-evm",
  "version": "0.4.2",
  "description": "A simple package that lets @anywalletkit/wallet-evm wallet accounts discover the token approvals they have granted (ERC-20 allowances, ERC-721 / ERC-1155 operators and per-token approvals, Permit2 allowances, EIP-7702 delegations), flag the risky ones, and revoke them one by one or all at once.",
  "license": "Apache-2.0",
  "homepage": "https://docs.anywallet.tech",
  "bugs": { "url": "https://github.com/ultratestbro/anywalletkit/issues" },
  "repository": { "type": "git", "url": "git+https://github.com/ultratestbro/anywalletkit.git", "directory": "packages/protocol-approvals-evm" },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "module.json",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "echo ok",
    "verify:live": "node scripts/verify-live.mjs"
  },
  "dependencies": {
    "viem": "^2.57.2"
  },
  "peerDependencies": {
    "@anywalletkit/core": "workspace:*"
  },
  "devDependencies": {
    "@anywalletkit/conformance": "workspace:*",
    "@anywalletkit/core": "workspace:*",
    "@types/node": "^22",
    "vitest": "^5.0.3"
  },
  "keywords": [
    "protocol",
    "approvals",
    "allowance",
    "revoke",
    "permit2",
    "erc20",
    "erc721",
    "erc1155",
    "eip7702",
    "security",
    "ethereum",
    "anywalletkit",
    "approvals"
  ],
  "publishConfig": { "access": "public", "provenance": true }
}
