{
  "name": "@anywalletkit/runtime-hermes",
  "version": "0.3.1",
  "description": "The one documented place for React Native / Hermes polyfills Any Wallet Kit relies on: AbortSignal.timeout/any, crypto.subtle.digest, TextEncoder checks, Buffer.",
  "license": "Apache-2.0",
  "homepage": "https://docs.anywallet.tech",
  "bugs": { "url": "https://github.com/ultratestbro/anywalletkit/issues" },
  "repository": { "type": "git", "url": "git+https://github.com/ultratestbro/anywalletkit.git", "directory": "packages/runtime-hermes" },
  "type": "module",
  "engines": { "node": ">=22" },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./fast-pbkdf2": {
      "types": "./dist/fast-pbkdf2.d.ts",
      "import": "./dist/fast-pbkdf2.js",
      "require": "./dist/fast-pbkdf2.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "keywords": [
    "react-native",
    "hermes",
    "polyfill",
    "abortsignal",
    "webcrypto"
  ],
  "dependencies": {
    "@noble/hashes": "^2.4.0"
  },
  "devDependencies": {
    "vitest": "^5.0.3"
  },
  "publishConfig": { "access": "public", "provenance": true }
}
