{
  "name": "@anywalletkit/protocol-swap2-fynd",
  "version": "0.1.1",
  "description": "Fynd (Propeller Heads) same-chain swaps for Any Wallet Kit: exact-input routes across the pools Tycho indexes on Ethereum, Base, Arbitrum, BNB Chain, Polygon, Unichain and Robinhood Chain, settled through TychoRouterV3 with the transaction checked against the request before signing.",
  "license": "Apache-2.0",
  "homepage": "https://docs.anywallet.tech",
  "bugs": {
    "url": "https://github.com/ultratestbro/anywalletkit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ultratestbro/anywalletkit.git",
    "directory": "packages/protocol-swap2-fynd"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./provider": {
      "types": "./dist/provider.d.ts",
      "import": "./dist/provider.js",
      "require": "./dist/provider.cjs"
    },
    "./router": {
      "types": "./dist/router.d.ts",
      "import": "./dist/router.js",
      "require": "./dist/router.cjs"
    },
    "./activity": {
      "types": "./dist/activity.d.ts",
      "import": "./dist/activity.js",
      "require": "./dist/activity.cjs"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js",
      "require": "./dist/protocol.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "module.json"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "echo ok"
  },
  "dependencies": {
    "@anywalletkit/protocol-swap2-core": "workspace:*",
    "@anywalletkit/swap2-assets": "workspace:*",
    "viem": "^2.57.2"
  },
  "peerDependencies": {
    "@anywalletkit/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22",
    "vitest": "^5.0.3",
    "@anywalletkit/conformance": "workspace:*",
    "@anywalletkit/core": "workspace:*"
  },
  "keywords": [
    "swap2",
    "swap",
    "dex-aggregator",
    "fynd",
    "tycho",
    "evm",
    "anywalletkit"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
