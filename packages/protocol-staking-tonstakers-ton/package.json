{
  "name": "@forgewallet/protocol-staking-tonstakers-ton",
  "version": "0.2.0",
  "description": "A simple package that lets @forgewallet/wallet-ton wallet accounts stake through Tonstakers: stake GRAM \u2192 tsTON, unstake instant / standard / best-rate, track payout bills, rates and APY.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "index.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./index.js"
    },
    "./package": {
      "default": "./package.json"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "src",
    "types",
    "module.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "echo \"plain ESM, nothing to build\"",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.js && vitest run",
    "lint": "echo ok",
    "verify:live": "node scripts/verify-live.mjs"
  },
  "dependencies": {
    "@ton/core": "^0.63.1",
    "@ton/ton": "^16.2.4",
    "buffer": "^6.0.3"
  },
  "peerDependencies": {
    "@forgewallet/core": "workspace:*"
  },
  "devDependencies": {
    "@forgewallet/core": "workspace:*",
    "@forgewallet/conformance": "workspace:*",
    "vitest": "^5.0.3"
  },
  "keywords": [
    "protocol",
    "staking",
    "tonstakers",
    "tston",
    "ton",
    "gram",
    "liquid-staking",
    "staking-protocol",
    "forgewallet",
    "staking"
  ],
  "sideEffects": [
    "./index.js",
    "./src/buffer-global.js",
    "./src/tonstakers-protocol-ton.js"
  ]
}
