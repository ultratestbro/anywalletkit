{
  "name": "@anywalletkit/protocol-swap2-relay",
  "version": "0.1.0",
  "description": "Relay (relay.link) for the swap2 engine, with the whole order verified on the device before anything is signed: the order id recomputed from the order (EIP-712 hashStruct), the solver's signature recovered to a pinned signer, recipient / chain / token / minimum / refunds held to the user's request, and the deposit built here for the pinned RelayDepository. EVM to EVM, exact input, native coin and ERC-20.",
  "license": "Apache-2.0",
  "homepage": "https://docs.anywallet.tech",
  "bugs": { "url": "https://github.com/ultratestbro/anywalletkit/issues" },
  "repository": { "type": "git", "url": "git+https://github.com/ultratestbro/anywalletkit.git", "directory": "packages/protocol-swap2-relay" },
  "type": "module",
  "engines": { "node": ">=22" },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" },
    "./config": { "types": "./dist/config.d.ts", "import": "./dist/config.js", "require": "./dist/config.cjs" },
    "./order": { "types": "./dist/order.d.ts", "import": "./dist/order.js", "require": "./dist/order.cjs" },
    "./verify": { "types": "./dist/verify.d.ts", "import": "./dist/verify.js", "require": "./dist/verify.cjs" },
    "./provider": { "types": "./dist/provider.d.ts", "import": "./dist/provider.js", "require": "./dist/provider.cjs" },
    "./protocol": { "types": "./dist/protocol.d.ts", "import": "./dist/protocol.js", "require": "./dist/protocol.cjs" },
    "./activity": { "types": "./dist/activity.d.ts", "import": "./dist/activity.js", "require": "./dist/activity.cjs" },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "module.json"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "verify:live": "node scripts/verify-live.mjs"
  },
  "dependencies": {
    "@anywalletkit/protocol-swap2-core": "workspace:*",
    "@anywalletkit/swap2-assets": "workspace:*",
    "@noble/curves": "^2.4.0",
    "viem": "^2.57.2"
  },
  "peerDependencies": { "@anywalletkit/core": "workspace:*" },
  "devDependencies": {
    "@types/node": "^22",
    "vitest": "^5.1.0",
    "@anywalletkit/conformance": "workspace:*",
    "@anywalletkit/protocol-swap2-router": "workspace:*",
    "@anywalletkit/core": "workspace:*"
  },
  "keywords": ["swap2", "bridge", "relay", "relay.link", "intents", "eip-712", "anywalletkit"],
  "publishConfig": { "access": "public", "provenance": true }
}
