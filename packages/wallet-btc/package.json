{
  "name": "@forgewallet/wallet-btc",
  "version": "0.0.1",
  "description": "Bitcoin wallet for the forgewallet SDK on @scure/btc-signer: BIP-84 p2wpkh and BIP-86 taproot accounts, own coin selection, RBF, Blockbook/Esplora transports.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./history": {
      "types": "./dist/history.d.ts",
      "import": "./dist/history.js",
      "require": "./dist/history.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "echo ok"
  },
  "keywords": [
    "wallet",
    "bitcoin",
    "bip84",
    "bip86",
    "taproot",
    "psbt",
    "blockbook",
    "esplora"
  ],
  "dependencies": {
    "@forgewallet/core": "workspace:*",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@scure/base": "^2.4.0",
    "@scure/btc-signer": "^2.4.1"
  },
  "devDependencies": {
    "@forgewallet/conformance": "workspace:*",
    "vitest": "^5.0.3"
  }
}
