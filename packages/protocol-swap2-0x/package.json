{
  "name": "@anywalletkit/protocol-swap2-0x",
  "version": "0.1.3",
  "description": "0x Swap API v2 same-chain swaps for Any Wallet Kit: Permit2 quotes on Ethereum, Base, Arbitrum, Optimism, Polygon, Avalanche and BNB Smart Chain, settled through the 0x Settler read from the on-chain registry, with the Permit2 payload rebuilt and the transaction checked against the request before signing.",
  "license": "Apache-2.0",
  "homepage": "https://docs.anywallet.tech",
  "bugs": {
    "url": "https://github.com/ultratestbro/anywalletkit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ultratestbro/anywalletkit.git",
    "directory": "packages/protocol-swap2-0x"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./provider": {
      "types": "./dist/provider.d.ts",
      "import": "./dist/provider.js",
      "require": "./dist/provider.cjs"
    },
    "./settler": {
      "types": "./dist/settler.d.ts",
      "import": "./dist/settler.js",
      "require": "./dist/settler.cjs"
    },
    "./chains": {
      "types": "./dist/chains.d.ts",
      "import": "./dist/chains.js",
      "require": "./dist/chains.cjs"
    },
    "./remote": {
      "types": "./dist/remote.d.ts",
      "import": "./dist/remote.js",
      "require": "./dist/remote.cjs"
    },
    "./activity": {
      "types": "./dist/activity.d.ts",
      "import": "./dist/activity.js",
      "require": "./dist/activity.cjs"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js",
      "require": "./dist/protocol.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "module.json"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "verify:live": "node scripts/verify-live.mjs"
  },
  "dependencies": {
    "@anywalletkit/protocol-swap2-core": "workspace:*",
    "viem": "^2.57.2"
  },
  "peerDependencies": {
    "@anywalletkit/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22",
    "vitest": "^5.1.0",
    "@anywalletkit/conformance": "workspace:*",
    "@anywalletkit/core": "workspace:*",
    "@anywalletkit/protocol-swap2-router": "workspace:*",
    "@anywalletkit/wallet-evm": "workspace:*"
  },
  "keywords": [
    "swap2",
    "swap",
    "dex-aggregator",
    "0x",
    "permit2",
    "evm",
    "anywalletkit"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
