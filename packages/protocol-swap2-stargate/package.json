{
  "name": "@anywalletkit/protocol-swap2-stargate",
  "version": "0.0.0",
  "private": true,
  "description": "Stargate V2 Taxi quotes and execution, historical Taxi/Bus recovery, and read-only compose evidence. Private integration in development.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "fixtures:upstream": "node scripts/capture-upstream.mjs",
    "fixtures:live": "node scripts/capture-live.mjs",
    "fixtures:receipts": "pnpm --filter @anywalletkit/networks build && node scripts/capture-receipts.mjs",
    "fixtures:bus": "pnpm build && node scripts/capture-bus.mjs",
    "fixtures:recovery": "pnpm build && node scripts/capture-recovery.mjs",
    "registry:capture": "pnpm --filter @anywalletkit/networks --filter @anywalletkit/swap2-assets build && node scripts/capture-registry.mjs",
    "fixtures:compose": "pnpm build && node scripts/capture-compose.mjs"
  },
  "dependencies": {
    "viem": "^2.57.2",
    "@anywalletkit/protocol-swap2-core": "workspace:*",
    "@anywalletkit/swap2-assets": "workspace:*"
  },
  "devDependencies": {
    "@anywalletkit/networks": "workspace:*",
    "@types/node": "^22",
    "vitest": "^5.0.3",
    "@anywalletkit/core": "workspace:*",
    "@anywalletkit/conformance": "workspace:*",
    "@anywalletkit/protocol-swap2-router": "workspace:*"
  },
  "peerDependencies": {
    "@anywalletkit/core": "workspace:*"
  },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./provider": {
      "types": "./dist/provider.d.ts",
      "import": "./dist/provider.js",
      "require": "./dist/provider.cjs"
    },
    "./pins": {
      "types": "./dist/pins.d.ts",
      "import": "./dist/pins.js",
      "require": "./dist/pins.cjs"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js",
      "require": "./dist/protocol.cjs"
    },
    "./quote": {
      "types": "./dist/quote.d.ts",
      "import": "./dist/quote.js",
      "require": "./dist/quote.cjs"
    },
    "./tracking": {
      "types": "./dist/tracking.d.ts",
      "import": "./dist/tracking.js",
      "require": "./dist/tracking.cjs"
    },
    "./registry": {
      "types": "./dist/registry.d.ts",
      "import": "./dist/registry.js",
      "require": "./dist/registry.cjs"
    },
    "./deployments": {
      "types": "./dist/deployments.d.ts",
      "import": "./dist/deployments.js",
      "require": "./dist/deployments.cjs"
    },
    "./amounts": {
      "types": "./dist/amounts.d.ts",
      "import": "./dist/amounts.js",
      "require": "./dist/amounts.cjs"
    },
    "./abi": {
      "types": "./dist/abi.d.ts",
      "import": "./dist/abi.js",
      "require": "./dist/abi.cjs"
    },
    "./package.json": "./package.json",
    "./compose": {
      "types": "./dist/compose.d.ts",
      "import": "./dist/compose.js",
      "require": "./dist/compose.cjs"
    },
    "./compose-dex": {
      "types": "./dist/compose-dex.d.ts",
      "import": "./dist/compose-dex.js",
      "require": "./dist/compose-dex.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "license": "Apache-2.0",
  "homepage": "https://docs.anywallet.tech",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ultratestbro/anywalletkit.git",
    "directory": "packages/protocol-swap2-stargate"
  },
  "bugs": {
    "url": "https://github.com/ultratestbro/anywalletkit/issues"
  },
  "keywords": [
    "anywalletkit",
    "wallet",
    "layerzero",
    "stargate"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
