{
  "name": "@forgewallet/protocol-staking-ssv-evm",
  "version": "0.2.0",
  "description": "A simple package that lets @forgewallet/wallet-evm wallet accounts stake SSV through SSV Network: stake SSV → cSSV, claim ETH rewards, cooldown unstake and withdraw.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "module.json",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "echo ok",
    "verify:live": "node scripts/verify-live.mjs"
  },
  "dependencies": {
    "viem": "^2.57.2"
  },
  "peerDependencies": {
    "@forgewallet/core": "workspace:*"
  },
  "devDependencies": {
    "@forgewallet/conformance": "workspace:*",
    "@forgewallet/core": "workspace:*",
    "@types/node": "^22",
    "vitest": "^5.0.3"
  },
  "keywords": [
    "protocol",
    "staking",
    "ssv",
    "ssv-network",
    "cssv",
    "ethereum",
    "staking-protocol",
    "forgewallet",
    "staking"
  ]
}
