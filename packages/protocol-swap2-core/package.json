{
  "name": "@anywalletkit/protocol-swap2-core",
  "version": "0.4.1",
  "description": "The swap2 engine for Any Wallet Kit: one interface for swaps and bridges, quote binding, approvals, review gate, fee caps and status resume; providers plug in as separate packages.",
  "license": "Apache-2.0",
  "homepage": "https://docs.anywallet.tech",
  "bugs": { "url": "https://github.com/ultratestbro/anywalletkit/issues" },
  "repository": { "type": "git", "url": "git+https://github.com/ultratestbro/anywalletkit.git", "directory": "packages/protocol-swap2-core" },
  "type": "module",
  "engines": { "node": ">=20" },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.cjs"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.js",
      "require": "./dist/errors.cjs"
    },
    "./validate": {
      "types": "./dist/validate.d.ts",
      "import": "./dist/validate.js",
      "require": "./dist/validate.cjs"
    },
    "./slippage": {
      "types": "./dist/slippage.d.ts",
      "import": "./dist/slippage.js",
      "require": "./dist/slippage.cjs"
    },
    "./remote": {
      "types": "./dist/remote.d.ts",
      "import": "./dist/remote.js",
      "require": "./dist/remote.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    },
    "./util": {
      "types": "./dist/util.d.ts",
      "import": "./dist/util.js",
      "require": "./dist/util.cjs"
    },
    "./activity": {
      "types": "./dist/activity.d.ts",
      "import": "./dist/activity.js",
      "require": "./dist/activity.cjs"
    },
    "./swap2/base": {
      "types": "./dist/swap2/base.d.ts",
      "import": "./dist/swap2/base.js",
      "require": "./dist/swap2/base.cjs"
    },
    "./swap2/single": {
      "types": "./dist/swap2/single.d.ts",
      "import": "./dist/swap2/single.js",
      "require": "./dist/swap2/single.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@anywalletkit/swap2-assets": "workspace:*",
    "@anywalletkit/tx-preview-evm": "workspace:*",
    "viem": "^2.45.0"
  },
  "peerDependencies": {
    "@anywalletkit/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22",
    "vitest": "^5.0.3",
    "@anywalletkit/conformance": "workspace:*",
    "@anywalletkit/core": "workspace:*"
  },
  "keywords": [],
  "publishConfig": { "access": "public", "provenance": true }
}
