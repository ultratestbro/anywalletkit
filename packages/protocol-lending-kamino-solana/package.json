{
  "name": "@anywalletkit/protocol-lending-kamino-solana",
  "version": "0.1.2",
  "description": "Kamino for @anywalletkit/wallet-solana accounts: Kamino Earn vaults (kVaults: deposit / withdraw, shares, APY) and Kamino Lend markets (supply, withdraw, borrow, repay against an obligation) as LendingProtocols. Transactions come from Kamino's official API and are signed only after the wallet's serialized-transaction guard proves the programs and the balance changes; positions, APY and TVL from the same API.",
  "license": "Apache-2.0",
  "homepage": "https://docs.anywallet.tech",
  "bugs": { "url": "https://github.com/ultratestbro/anywalletkit/issues" },
  "repository": { "type": "git", "url": "git+https://github.com/ultratestbro/anywalletkit.git", "directory": "packages/protocol-lending-kamino-solana" },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "module.json"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "echo ok",
    "verify:live": "node scripts/verify-live.mjs"
  },
  "peerDependencies": { "@anywalletkit/core": "workspace:*" },
  "devDependencies": {
    "@anywalletkit/conformance": "workspace:*",
    "@anywalletkit/core": "workspace:*",
    "@anywalletkit/wallet-solana": "workspace:*",
    "@types/node": "^22",
    "vitest": "^5.0.3"
  },
  "keywords": ["protocol", "lending", "kamino", "klend", "kvault", "earn", "vault", "borrow", "solana", "lending-protocol", "anywalletkit"],
  "publishConfig": { "access": "public", "provenance": true }
}
