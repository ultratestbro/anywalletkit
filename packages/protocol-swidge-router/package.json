{
  "name": "@forgewallet/protocol-swidge-router",
  "version": "0.0.1",
  "description": "Optional swidge aggregator for the forgewallet SDK: auctions whichever swidge providers you install and pass in.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./router": {
      "types": "./dist/router.d.ts",
      "import": "./dist/router.js",
      "require": "./dist/router.cjs"
    },
    "./swidge/router": {
      "types": "./dist/swidge/router.d.ts",
      "import": "./dist/swidge/router.js",
      "require": "./dist/swidge/router.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "module.json"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "echo ok"
  },
  "dependencies": {
    "@forgewallet/protocol-swidge-core": "workspace:*"
  },
  "peerDependencies": {
    "@forgewallet/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22",
    "vitest": "^5.0.3",
    "@forgewallet/conformance": "workspace:*",
    "@forgewallet/core": "workspace:*"
  },
  "keywords": []
}
