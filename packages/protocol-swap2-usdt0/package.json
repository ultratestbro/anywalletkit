{
  "name": "@anywalletkit/protocol-swap2-usdt0",
  "version": "0.4.4",
  "description": "USDT0 (Tether's LayerZero OFT for USDT) for the swap2 engine: USDT / USDT0 between 16 EVM chains, and USDT from Ethereum / Arbitrum / Celo into Tron and TON through the USDT0 Legacy Mesh, in one source transaction — quoteOFT + quoteSend on the OFT itself, send with the LayerZero fee as msg.value, status from LayerZero Scan (TON payout from tonapi), lzReceive retry of a stored payload as the claim. Bound to the deployments docs.usdt0.to lists, re-verified on-chain.",
  "license": "Apache-2.0",
  "homepage": "https://docs.anywallet.tech",
  "bugs": { "url": "https://github.com/ultratestbro/anywalletkit/issues" },
  "repository": { "type": "git", "url": "git+https://github.com/ultratestbro/anywalletkit.git", "directory": "packages/protocol-swap2-usdt0" },
  "type": "module",
  "engines": { "node": ">=22" },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" },
    "./config": { "types": "./dist/config.d.ts", "import": "./dist/config.js", "require": "./dist/config.cjs" },
    "./provider": { "types": "./dist/provider.d.ts", "import": "./dist/provider.js", "require": "./dist/provider.cjs" },
    "./protocol": { "types": "./dist/protocol.d.ts", "import": "./dist/protocol.js", "require": "./dist/protocol.cjs" },
    "./activity": { "types": "./dist/activity.d.ts", "import": "./dist/activity.js", "require": "./dist/activity.cjs" },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "module.json"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "verify:live": "node scripts/verify-live.mjs",
    "verify:live:mesh": "node scripts/verify-live-mesh.mjs"
  },
  "dependencies": {
    "@anywalletkit/protocol-swap2-core": "workspace:*",
    "@anywalletkit/swap2-assets": "workspace:*",
    "@scure/base": "^2.4.0",
    "viem": "^2.57.2"
  },
  "peerDependencies": { "@anywalletkit/core": "workspace:*" },
  "devDependencies": {
    "@types/node": "^22",
    "vitest": "^5.1.0",
    "@anywalletkit/conformance": "workspace:*",
    "@anywalletkit/protocol-swap2-router": "workspace:*",
    "@anywalletkit/core": "workspace:*"
  },
  "keywords": ["swap2", "bridge", "usdt0", "usdt", "tether", "layerzero", "oft", "legacy-mesh", "tron", "ton", "anywalletkit"],
  "publishConfig": { "access": "public", "provenance": true }
}
