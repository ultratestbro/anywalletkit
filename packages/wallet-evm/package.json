{
  "name": "@anywalletkit/wallet-evm",
  "version": "0.2.0",
  "description": "EVM wallet for Any Wallet Kit: BIP-32 m/44'/60'/0'/0/i accounts, EIP-191 / EIP-712 / EIP-1559 signing, ERC-20 transfer and approve, built on viem.",
  "license": "Apache-2.0",
  "homepage": "https://docs.anywallet.tech",
  "bugs": { "url": "https://github.com/ultratestbro/anywalletkit/issues" },
  "repository": { "type": "git", "url": "git+https://github.com/ultratestbro/anywalletkit.git", "directory": "packages/wallet-evm" },
  "type": "module",
  "engines": { "node": ">=20" },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "keywords": [
    "wallet",
    "evm",
    "ethereum",
    "viem",
    "bip32",
    "eip1559",
    "eip712",
    "erc20"
  ],
  "dependencies": {
    "@anywalletkit/core": "workspace:*",
    "@noble/curves": "^2.4.0",
    "viem": "^2.57.2"
  },
  "devDependencies": {
    "@anywalletkit/conformance": "workspace:*",
    "@anywalletkit/kit": "workspace:*",
    "vitest": "^5.0.3"
  },
  "publishConfig": { "access": "public", "provenance": true }
}
