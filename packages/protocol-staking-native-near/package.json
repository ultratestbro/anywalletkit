{
  "name": "@anywalletkit/protocol-staking-native-near",
  "version": "0.0.0",
  "description": "Native NEAR staking for any NEAR account: deposit_and_stake into the staking pools your app allows (standard *.poolv1.near / *.pool.near pools with a known code hash, live fee and pause checks). Unstake with the 4-epoch (about 21–28 h) unbonding countdown, withdraw, pool info with APR from the protocol's own reward data, positions across pools. Quotes return the exact NEAR transactions, so an external signer (wallet-selector) signs what was shown.",
  "license": "Apache-2.0",
  "homepage": "https://docs.anywallet.tech",
  "bugs": { "url": "https://github.com/ultratestbro/anywalletkit/issues" },
  "repository": { "type": "git", "url": "git+https://github.com/ultratestbro/anywalletkit.git", "directory": "packages/protocol-staking-native-near" },
  "type": "module",
  "engines": { "node": ">=22" },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "module.json", "LICENSE"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "verify:live": "node scripts/verify-live.mjs"
  },
  "dependencies": {
    "@anywalletkit/wallet-near": "workspace:*",
    "@noble/hashes": "^2.4.0"
  },
  "peerDependencies": { "@anywalletkit/core": "workspace:*" },
  "devDependencies": {
    "@anywalletkit/conformance": "workspace:*",
    "@anywalletkit/core": "workspace:*",
    "@types/node": "^22",
    "vitest": "^5.0.3"
  },
  "keywords": ["protocol", "staking", "near", "native-staking", "staking-pool", "validator", "delegation", "staking-protocol", "anywalletkit"],
  "publishConfig": { "access": "public", "provenance": true }
}
