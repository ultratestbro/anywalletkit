{
  "name": "@anywalletkit/protocol-staking-native-solana",
  "version": "0.1.4",
  "description": "Native Solana staking for @anywalletkit/wallet-solana accounts: delegate SOL straight to the validators your app lists, through the Stake program. Seed-derived stake accounts (only the wallet signs, the position rebuilds from the wallet), exact activation status from StakeHistory, partial unstake by split, claim, re-delegate, merge, validator info with commission and APR, rewards per epoch.",
  "license": "Apache-2.0",
  "homepage": "https://docs.anywallet.tech",
  "bugs": { "url": "https://github.com/ultratestbro/anywalletkit/issues" },
  "repository": { "type": "git", "url": "git+https://github.com/ultratestbro/anywalletkit.git", "directory": "packages/protocol-staking-native-solana" },
  "type": "module",
  "engines": { "node": ">=22" },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js", "require": "./dist/index.cjs" },
    "./package.json": "./package.json"
  },
  "files": ["dist", "README.md", "module.json"],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "verify:live": "node scripts/verify-live.mjs"
  },
  "dependencies": { "@noble/hashes": "^2.4.0" },
  "peerDependencies": { "@anywalletkit/core": "workspace:*" },
  "devDependencies": {
    "@anywalletkit/conformance": "workspace:*",
    "@anywalletkit/core": "workspace:*",
    "@anywalletkit/wallet-solana": "workspace:*",
    "@types/node": "^22",
    "vitest": "^5.0.3"
  },
  "keywords": ["protocol", "staking", "solana", "native-staking", "stake-account", "validator", "delegation", "staking-protocol", "anywalletkit"],
  "publishConfig": { "access": "public", "provenance": true }
}
