{
  "name": "@anywalletkit/networks",
  "version": "0.2.2",
  "description": "Networks for Any Wallet Kit wallets: the catalog of mainnets with public RPC failover lists, default testnets for every chain family, user-added networks and custom RPCs (NetworksTable over any JSON storage), per-family endpoint verification (chain id / genesis / global id must match) and the http-only-for-local-nodes URL policy. Shared by the mobile app and the extension kit.",
  "license": "Apache-2.0",
  "homepage": "https://docs.anywallet.tech",
  "bugs": { "url": "https://github.com/ultratestbro/anywalletkit/issues" },
  "repository": { "type": "git", "url": "git+https://github.com/ultratestbro/anywalletkit.git", "directory": "packages/networks" },
  "type": "module",
  "engines": { "node": ">=20" },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "verify:live": "node scripts/verify-live.mjs"
  },
  "dependencies": {
    "@anywalletkit/swap2-assets": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22",
    "vitest": "^5.0.3"
  },
  "keywords": [
    "networks",
    "rpc",
    "testnet",
    "caip-2",
    "eip-3085",
    "custom-rpc",
    "anywalletkit"
  ],
  "publishConfig": { "access": "public", "provenance": true }
}
