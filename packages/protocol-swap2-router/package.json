{
  "name": "@anywalletkit/protocol-swap2-router",
  "version": "0.2.7",
  "description": "Optional swap2 aggregator for Any Wallet Kit: auctions whichever swap2 providers you install and pass in.",
  "license": "Apache-2.0",
  "homepage": "https://docs.anywallet.tech",
  "bugs": { "url": "https://github.com/ultratestbro/anywalletkit/issues" },
  "repository": { "type": "git", "url": "git+https://github.com/ultratestbro/anywalletkit.git", "directory": "packages/protocol-swap2-router" },
  "type": "module",
  "engines": { "node": ">=22" },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./router": {
      "types": "./dist/router.d.ts",
      "import": "./dist/router.js",
      "require": "./dist/router.cjs"
    },
    "./value": {
      "types": "./dist/value.d.ts",
      "import": "./dist/value.js",
      "require": "./dist/value.cjs"
    },
    "./swap2/router": {
      "types": "./dist/swap2/router.d.ts",
      "import": "./dist/swap2/router.js",
      "require": "./dist/swap2/router.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "module.json"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src"
  },
  "dependencies": {
    "@anywalletkit/protocol-swap2-core": "workspace:*",
    "@anywalletkit/swap2-assets": "workspace:*"
  },
  "peerDependencies": {
    "@anywalletkit/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22",
    "vitest": "^5.0.3",
    "@anywalletkit/conformance": "workspace:*",
    "@anywalletkit/core": "workspace:*"
  },
  "keywords": [],
  "publishConfig": { "access": "public", "provenance": true }
}
