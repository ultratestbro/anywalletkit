    "@ton/crypto": "^3.3.0",
    "buffer": "^6.0.3",
    "viem": "^2.45.0"
  },
  "peerDependencies": {
    "@forgewallet/core": "workspace:*"
  },
  "devDependencies": {
    "@forgewallet/conformance": "workspace:*",
    "@forgewallet/core": "workspace:*",
    "@types/node": "^22",
    "vitest": "^5.0.3"
  },
  "keywords": []
}
