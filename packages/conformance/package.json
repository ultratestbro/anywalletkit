{
  "name": "@anywalletkit/conformance",
  "version": "0.3.1",
  "description": "Conformance suites and golden vectors every Any Wallet Kit chain and protocol module must pass.",
  "license": "Apache-2.0",
  "homepage": "https://docs.anywallet.tech",
  "bugs": { "url": "https://github.com/ultratestbro/anywalletkit/issues" },
  "repository": { "type": "git", "url": "git+https://github.com/ultratestbro/anywalletkit.git", "directory": "packages/conformance" },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./vectors/derivation.json": "./vectors/derivation.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "vectors",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "echo 'lint: configured in phase 1'"
  },
  "peerDependencies": {
    "vitest": ">=2"
  },
  "dependencies": {
    "@anywalletkit/core": "workspace:*",
    "@anywalletkit/tx-preview-evm": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^5.0.3"
  },
  "publishConfig": { "access": "public", "provenance": true }
}
