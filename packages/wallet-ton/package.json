{
  "name": "@forgewallet/wallet-ton",
  "version": "0.0.1",
  "description": "TON wallet for the forgewallet SDK: SLIP-10 m/44'/607'/i' accounts on WalletContractV5R1, TON and jetton transfers, toncenter failover.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "./dist/index.js",
    "./dist/index.cjs"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "echo ok"
  },
  "keywords": [
    "wallet",
    "ton",
    "jetton",
    "slip10",
    "ed25519",
    "v5r1"
  ],
  "dependencies": {
    "@forgewallet/core": "workspace:*",
    "@ton/core": "^0.63.1",
    "@ton/crypto": "^3.3.0",
    "buffer": "^6.0.3"
  },
  "devDependencies": {
    "@forgewallet/conformance": "workspace:*",
    "@noble/curves": "^2.4.0",
    "vitest": "^5.0.3",
    "@ton/ton": "^16.3.0"
  }
}
