{
  "name": "@anywalletkit/protocol-lending-mellow-evm",
  "version": "0.3.6",
  "description": "A simple package that lets @anywalletkit/wallet-evm wallet accounts use Mellow Core Vaults (Lido EarnETH / EarnUSD and any vault on the same contracts): supply through the sync or async deposit queue, redeem and claim through the redeem queue, read the position, fees, oracle reports and APY.",
  "license": "Apache-2.0",
  "homepage": "https://docs.anywallet.tech",
  "bugs": { "url": "https://github.com/ultratestbro/anywalletkit/issues" },
  "repository": { "type": "git", "url": "git+https://github.com/ultratestbro/anywalletkit.git", "directory": "packages/protocol-lending-mellow-evm" },
  "type": "module",
  "engines": { "node": ">=20" },
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "module.json",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "verify:live": "node scripts/verify-live.mjs"
  },
  "dependencies": {
    "viem": "^2.57.2"
  },
  "peerDependencies": {
    "@anywalletkit/core": "workspace:*"
  },
  "devDependencies": {
    "@anywalletkit/conformance": "workspace:*",
    "@anywalletkit/core": "workspace:*",
    "@anywalletkit/wallet-evm": "workspace:*",
    "@types/node": "^22",
    "vitest": "^5.0.3"
  },
  "keywords": [
    "protocol",
    "lending",
    "vault",
    "mellow",
    "lido",
    "earn",
    "earneth",
    "earnusd",
    "ethereum",
    "lending-protocol",
    "anywalletkit",
    "lending"
  ],
  "publishConfig": { "access": "public", "provenance": true }
}
