{
  "name": "forgewallet",
  "private": true,
  "version": "0.0.0",
  "description": "Open multichain wallet SDK: one seed, every chain, protocol modules anyone can contribute.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.30.2",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/**' run build",
    "test": "pnpm -r --filter './packages/**' run test",
    "typecheck": "pnpm -r --filter './packages/**' run typecheck",
    "lint": "pnpm -r --filter './packages/**' run lint",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "test:hermes": "pnpm --filter @forgewallet/example-hermes-smoke test:hermes",
    "registry": "node scripts/build-registry.mjs",
    "registry:check": "node scripts/build-registry.mjs && git diff --exit-code registry/modules.json",
    "watch": "node scripts/watch/watch.mjs",
    "watch:baseline": "node scripts/watch/watch.mjs --baseline",
    "vendor": "node scripts/vendor.mjs",
    "test:examples": "pnpm --filter './examples/quickstart' --filter './examples/swap' --filter './examples/earn' --filter './examples/approvals' --filter './examples/tx-preview' -r run typecheck && pnpm --filter './examples/quickstart' --filter './examples/swap' --filter './examples/earn' --filter './examples/approvals' --filter './examples/tx-preview' -r run test",
    "docs:build": "pnpm --filter awk-docs build"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "fastestsmallesttextencoderdecoder": "^1.0.22",
    "hermes-engine-cli": "^0.12.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
